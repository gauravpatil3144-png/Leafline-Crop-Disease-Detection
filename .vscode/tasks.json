			"type": "shell",
			"command": "Get-Process",
			"args": [
				"-Name",
				"python"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Identify Cotton training process",
			"type": "shell",
			"command": "Get-CimInstance",
			"args": [
				"Win32_Process"
			],
			"isBackground": false,
			"problemMatcher": []
